{
  "schemaVersion": 1,
  "id": "elexis",
  "version": "${version}",
  "name": "Elexis",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "elexis.Elexis"
    ]
  },
  "mixins": [
